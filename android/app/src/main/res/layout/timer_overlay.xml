<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E6000000"
    android:padding="12dp"
    android:elevation="999dp">

    <!-- Timer Container (Ad Watching) -->
    <LinearLayout
        android:id="@+id/timerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/timer_bg"
        android:padding="16dp"
        android:gravity="center"
        android:elevation="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ Watching Advertisement"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 seconds"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <!-- Return to App Button on Overlay -->
        <Button
            android:id="@+id/btnBackToApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔙 BACK TO APP"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/click_button_background"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"/>

    </LinearLayout>

    <!-- Success Container (Timer Complete) -->
    <LinearLayout
        android:id="@+id/successContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/timer_bg_green"
        android:padding="20dp"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✅"
            android:textSize="48sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad Watched!"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Return to App Button on Success -->
        <Button
            android:id="@+id/btnSuccessBackToApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔙 RETURN TO APP"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/click_button_background"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"/>

    </LinearLayout>

    <!-- Click Button (Show when ready to earn) -->
    <Button
        android:id="@+id/clickButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎯 TAP TO EARN NOW!"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/click_button_background"
        android:layout_marginTop="12dp"
        android:paddingVertical="12dp"
        android:visibility="gone"
        android:elevation="12dp"/>

</LinearLayout>