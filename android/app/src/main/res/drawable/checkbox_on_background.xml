<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Gradient background -->
    <gradient
        android:type="linear"
        android:startColor="#FF6B00"
        android:endColor="#FF8C00"
        android:angle="135" />
    
    <!-- Rounded corners -->
    <corners android:radius="35dp" />
    
    <!-- Border -->
    <stroke
        android:width="4dp"
        android:color="#FF4500" />
    
    <!-- Padding -->
    <padding
        android:left="20dp"
        android:top="16dp"
        android:right="20dp"
        android:bottom="16dp" />
        
</shape>  