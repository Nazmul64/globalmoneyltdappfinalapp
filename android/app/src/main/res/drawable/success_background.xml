<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Green gradient background -->
    <gradient
        android:type="linear"
        android:startColor="#66BB6A"
        android:endColor="#43A047"
        android:angle="135" />
    
    <!-- Rounded corners -->
    <corners android:radius="28dp" />
    
    <!-- Dark green border -->
    <stroke
        android:width="4dp"
        android:color="#2E7D32" />
    
    <!-- Inner padding -->
    <padding
        android:left="24dp"
        android:top="24dp"
        android:right="24dp"
        android:bottom="24dp" />
        
</shape>